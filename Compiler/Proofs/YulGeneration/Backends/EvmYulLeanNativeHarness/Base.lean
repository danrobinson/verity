          (some (Backends.lowerExprNative
            Compiler.Proofs.YulGeneration.selectorExpr)))
        (some contract) initState = .ok discrState := by
    simpa [initState, discrState] using
      (exec_let_lowerExprNative_selectorExpr_initialState_store_ok_fuel
        fuel contract tx storage observableSlots store discrName hDiscrFresh)
  have hFreshMatched :
      EvmYul.Yul.State.lookup? matchedName discrState = none := by
    have hNe' : matchedName ≠ discrName := by
      intro h; exact hNamesNe h.symm
    simp [discrState, initState, EvmYul.Yul.State.insert,
      EvmYul.Yul.State.lookup?, hMatchedFresh,
      Finmap.lookup_insert_of_ne _ hNe']
  have hTail :
