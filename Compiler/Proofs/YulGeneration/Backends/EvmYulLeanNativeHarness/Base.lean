/-- Closed-block wrapper for the generated dispatcher switch prefix. The
    declared temps are scoped away when the block exits. -/
theorem exec_nativeSwitchPrefix_selector_initialState_ok_fuel
    (fuel : Nat) (contract : EvmYul.Yul.Ast.YulContract) (tx : YulTransaction)
    (storage : IRStorageSlot → IRStorageWord) (observableSlots : List Nat)
    (discrName matchedName : EvmYul.Identifier)
    (hNamesNe : discrName ≠ matchedName) :
    EvmYul.Yul.exec (fuel + 13)
      (.Block (nativeSwitchPrefixStmts discrName matchedName))
      (some contract) (nativeSwitchInitialOkState contract tx storage observableSlots) =
    .ok ((nativeSwitchPrefixFinalState contract tx storage observableSlots
      discrName matchedName).restrictStoreTo
        (nativeSwitchInitialOkState contract tx storage observableSlots).store) := by
  have hSeq :=
    execSeq_nativeSwitchPrefix_selector_initialState_ok_fuel fuel
      contract tx storage observableSlots discrName matchedName hNamesNe
  have hFuel : fuel + 13 = Nat.succ (fuel + 12) := by omega
  rw [hFuel]
  exact exec_block_of_execSeq_ok (fuel + 12)
    (nativeSwitchPrefixStmts discrName matchedName) (some contract)
    (nativeSwitchInitialOkState contract tx storage observableSlots)
    (nativeSwitchPrefixFinalState contract tx storage observableSlots
