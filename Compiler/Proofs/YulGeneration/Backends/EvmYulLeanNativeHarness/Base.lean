theorem execSeq_leave_ok_add_nine
    (fuel suffixLen : Nat)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State) :
    EvmYul.Yul.execSeq (fuel + suffixLen + 9) [.Leave] codeOverride state =
      .ok (state.setLeave) := by
  have hFuel : fuel + suffixLen + 9 = Nat.succ (fuel + suffixLen + 8) := by
    omega
  rw [hFuel]
  cases state <;> simp [EvmYul.Yul.execSeq, EvmYul.Yul.exec,
