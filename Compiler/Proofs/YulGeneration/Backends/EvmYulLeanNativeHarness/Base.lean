theorem state_foldr_insert_ok_exists
    (entries : List (EvmYul.Identifier × EvmYul.Literal))
    (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) :
    ∃ shared' store',
      entries.foldr (fun entry state =>
          EvmYul.Yul.State.insert entry.1 entry.2 state)
        (EvmYul.Yul.State.Ok shared store) =
        EvmYul.Yul.State.Ok shared' store' := by
  induction entries with
  | nil =>
      exact ⟨shared, store, rfl⟩
  | cons entry entries ih =>
      rcases ih with ⟨shared', store', h⟩
      rw [List.foldr_cons, h]
      exact ⟨shared', store'.insert entry.1 entry.2, rfl⟩

theorem state_mkOk_initcall_ok_exists
    (params : List EvmYul.Identifier)
    (rets : List EvmYul.Identifier)
    (values : List EvmYul.Literal)
    (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) :
    ∃ shared' store',
      EvmYul.Yul.State.mkOk
        (EvmYul.Yul.State.initcall params rets values
          (EvmYul.Yul.State.Ok shared store)) =
        EvmYul.Yul.State.Ok shared' store' := by
  let emptyStore : EvmYul.Yul.VarStore := Inhabited.default
  have hZero :
      ∃ shared₀ store₀,
        EvmYul.Yul.State.zeroFill rets
          (EvmYul.Yul.State.Ok shared emptyStore) =
          EvmYul.Yul.State.Ok shared₀ store₀ := by
    induction rets with
    | nil =>
        exact ⟨shared, emptyStore, by simp [EvmYul.Yul.State.zeroFill]⟩
    | cons ret rest ih =>
        rcases ih with ⟨shared₀, store₀, hRest⟩
        exact ⟨shared₀, store₀.insert ret (⟨0⟩ : EvmYul.Literal), by
          change
            (EvmYul.Yul.State.zeroFill rest
              (EvmYul.Yul.State.Ok shared emptyStore)).insert ret
                (⟨0⟩ : EvmYul.Literal) =
              EvmYul.Yul.State.Ok shared₀
                (store₀.insert ret (⟨0⟩ : EvmYul.Literal))
          rw [hRest]
          rfl⟩
  rcases hZero with ⟨shared₀, store₀, hZero⟩
  rcases state_foldr_insert_ok_exists (List.zip params values) shared₀
      store₀ with
    ⟨shared', store', hFill⟩
  have hMulti :
      EvmYul.Yul.State.multifill params values
        (EvmYul.Yul.State.Ok shared₀ store₀) =
        EvmYul.Yul.State.Ok shared' store' := by
    simpa [EvmYul.Yul.State.multifill] using hFill
  exact ⟨shared', store', by
    simp [EvmYul.Yul.State.initcall, EvmYul.Yul.State.setStore,
      EvmYul.Yul.State.mkOk, emptyStore]
    rw [hZero, hMulti]⟩

