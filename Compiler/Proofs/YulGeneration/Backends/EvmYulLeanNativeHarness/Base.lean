    (hMatched : EvmYul.Yul.State.lookup? matchedName state =
      some (EvmYul.UInt256.ofNat 0))
    (hMissPrefix : ∀ tag' body', (tag', body') ∈ pre →
        EvmYul.UInt256.ofNat tag ≠ EvmYul.UInt256.ofNat tag')
    (hDiscr : EvmYul.Yul.State.lookup? discrName state =
      some (EvmYul.UInt256.ofNat tag))
    (hBody :
      (match state.insert matchedName (EvmYul.UInt256.ofNat 1) with
      | .Ok _ _ =>
          EvmYul.Yul.execSeq (fuel + suffix.length + 6) body codeOverride
            (state.insert matchedName (EvmYul.UInt256.ofNat 1))
      | .OutOfFuel =>
          .ok (state.insert matchedName (EvmYul.UInt256.ofNat 1))
