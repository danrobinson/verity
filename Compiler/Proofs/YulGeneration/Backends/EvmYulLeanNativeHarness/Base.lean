theorem exec_lowerNativeSwitchBlock_storePrefix_tail_ok_fuel
    (fuel switchId : Nat)
    (cases : List (Nat × List EvmYul.Yul.Ast.Stmt))
    (defaultBody : List EvmYul.Yul.Ast.Stmt)
    (contract : EvmYul.Yul.Ast.YulContract) (tx : YulTransaction)
