theorem state_getElem_restrictStoreTo_of_getElem_eq
    (state scope : EvmYul.Yul.State)
    (name : EvmYul.Identifier)
    (hEq : state[name]! = scope[name]!) :
    (state.restrictStoreTo scope.store)[name]! = scope[name]! := by
  cases scope with
  | Ok scopeShared scopeStore =>
      cases state with
      | Ok shared store =>
          by_cases hScope : name ∈ scopeStore
          · by_cases hStore : name ∈ store
            · obtain ⟨storeValue, hStoreLookup⟩ := Finmap.mem_iff.mp hStore
              have hRestrictedLookup :=
                restrictVarStore_lookup_of_mem_scope name store scopeStore
                  hScope
              have hRestrictedMem :
                  name ∈ EvmYul.Yul.State.restrictVarStore store scopeStore :=
                Finmap.mem_of_lookup_eq_some (by
                  rw [hRestrictedLookup]
                  exact hStoreLookup)
              simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                GetElem?.getElem!, decidableGetElem?, GetElem.getElem,
                hScope, hStore, hRestrictedLookup, hRestrictedMem]
                at hEq ⊢
              exact hEq
            · have hStoreLookup : Finmap.lookup name store = none :=
                Finmap.lookup_eq_none.mpr hStore
              have hRestrictedLookup :=
                restrictVarStore_lookup_of_mem_scope name store scopeStore
                  hScope
              have hRestrictedNotMem :
                  name ∉ EvmYul.Yul.State.restrictVarStore store scopeStore :=
                Finmap.lookup_eq_none.mp (by
                  rw [hRestrictedLookup]
                  exact hStoreLookup)
              simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                GetElem?.getElem!, decidableGetElem?, GetElem.getElem,
                hScope, hStore, hRestrictedLookup, hRestrictedNotMem]
                at hEq ⊢
              exact hEq
          · have hRestrictedLookup :=
              restrictVarStore_lookup_of_not_mem_scope name store scopeStore
                hScope
            have hRestrictedNotMem :
                name ∉ EvmYul.Yul.State.restrictVarStore store scopeStore :=
              Finmap.lookup_eq_none.mp hRestrictedLookup
            simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
              EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
              GetElem?.getElem!, decidableGetElem?, GetElem.getElem,
              hScope, hRestrictedLookup, hRestrictedNotMem]
      | OutOfFuel =>
          simpa [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
            varStore_not_mem_default name] using hEq
      | Checkpoint jump =>
          by_cases hScope : name ∈ scopeStore
          · cases jump <;>
              simpa [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                GetElem?.getElem!, decidableGetElem?, GetElem.getElem,
                hScope, varStore_not_mem_default name] using hEq
          · cases jump <;>
              simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
                EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
                GetElem?.getElem!, decidableGetElem?, GetElem.getElem,
                hScope, varStore_not_mem_default name]
  | OutOfFuel =>
      simpa [EvmYul.Yul.State.store, GetElem?.getElem!, decidableGetElem?,
        GetElem.getElem, varStore_not_mem_default name,
        literal_outOfBounds_eq_default] using
        state_getElem_restrictStoreTo_default state name
  | Checkpoint jump =>
      cases jump <;>
        simpa [EvmYul.Yul.State.store, GetElem?.getElem!, decidableGetElem?,
          GetElem.getElem, varStore_not_mem_default name,
          literal_outOfBounds_eq_default] using
          state_getElem_restrictStoreTo_default state name

theorem varStore_lookup_some_of_getD_eq_one
    (store : EvmYul.Yul.VarStore)
