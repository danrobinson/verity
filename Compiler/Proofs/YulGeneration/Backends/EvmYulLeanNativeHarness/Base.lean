            (nativeSwitchDefaultIf matchedName defaultBody)
            (some contract) scopedFinal
      | .OutOfFuel => .ok scopedFinal
      | .Checkpoint _ => .ok scopedFinal) = .ok scopedFinal := by
    cases hScopedFinal : scopedFinal with
