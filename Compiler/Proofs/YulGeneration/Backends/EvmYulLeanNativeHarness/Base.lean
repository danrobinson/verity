    EvmYul.Yul.exec (fuel + cases.length + 15)
      (.Block [Backends.lowerNativeSwitchBlock
        Compiler.Proofs.YulGeneration.selectorExpr switchId cases
        [nativeRevertZeroZeroStmt]])
