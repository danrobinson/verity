/-- Store-parametric form of `exec_let_lowerExprNative_selectorExpr_initialState_ok_fuel`.
    The lowered selector eval reads only calldata from the shared state, so
    the `let __discr := selectorExpr` step is invariant under any preceding
    native-side varstore. Lets us chain the dispatcher prefix's discriminator
    binding on a state that already carries `__has_selector := 1` (left by
    the buildSwitch wrapper). -/
theorem exec_let_lowerExprNative_selectorExpr_initialState_store_ok_fuel
    (fuel : Nat)
    (contract : EvmYul.Yul.Ast.YulContract)
    (tx : YulTransaction)
    (storage : IRStorageSlot → IRStorageWord)
    (observableSlots : List Nat)
    (store : EvmYul.Yul.VarStore)
    (discrName : EvmYul.Identifier)
    (hFresh : store.lookup discrName = none) :
    EvmYul.Yul.exec (fuel + 11)
        (.Let [discrName]
          (some (Backends.lowerExprNative Compiler.Proofs.YulGeneration.selectorExpr)))
        (some contract)
        (.Ok (initialState contract tx storage observableSlots).sharedState store) =
      .ok ((.Ok (initialState contract tx storage observableSlots).sharedState store :
          EvmYul.Yul.State).insert discrName
        (EvmYul.UInt256.ofNat
          (tx.functionSelector % Compiler.Constants.selectorModulus))) := by
  have hv :=
    initialState_selectorExpr_native_uint256 contract tx storage observableSlots
  have hv224 :
      EvmYul.UInt256.shiftRight
        (EvmYul.State.calldataload
          (EvmYul.SharedState.toState
            (initialState contract tx storage observableSlots).sharedState)
          (EvmYul.UInt256.ofNat 0))
        (EvmYul.UInt256.ofNat 224) =
      EvmYul.UInt256.ofNat
        (tx.functionSelector % Compiler.Constants.selectorModulus) := by
    simpa [Compiler.Constants.selectorShift] using hv
  rw [lowerExprNative_selectorExpr]
  simp [EvmYul.Yul.exec, EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.evalArgs,
    EvmYul.Yul.evalTail, EvmYul.Yul.evalPrimCall, EvmYul.Yul.execPrimCall,
    EvmYul.Yul.checkDeclaration, EvmYul.Yul.firstDuplicate?,
    EvmYul.Yul.firstDeclared?, EvmYul.Yul.State.lookup?, hFresh,
    EvmYul.Yul.reverse', EvmYul.Yul.cons', EvmYul.Yul.head',
    EvmYul.Yul.multifill', EvmYul.Yul.State.multifill,
    Compiler.Constants.selectorShift]
  rw [hv224]

theorem exec_let_lit_ok
    (fuel' : Nat)
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (hFresh : EvmYul.Yul.State.lookup? name state = none) :
    EvmYul.Yul.exec (fuel' + 2)
        (.Let [name] (some (.Lit value))) codeOverride state =
      .ok (state.insert name value) := by
  cases fuel' <;> cases state <;>
    simp [EvmYul.Yul.exec, EvmYul.Yul.checkDeclaration,
      EvmYul.Yul.firstDuplicate?, EvmYul.Yul.firstDeclared?, hFresh,
      EvmYul.Yul.evalValues, EvmYul.Yul.multifill',
      EvmYul.Yul.State.multifill, EvmYul.Yul.State.insert]

/-- Current EVMYulLean sequence semantics: if the head statement errors,
    the surrounding open sequence errors before reaching the tail. -/
theorem execSeq_cons_error
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hHead : EvmYul.Yul.exec fuel' stmt codeOverride state = .error err) :
    EvmYul.Yul.execSeq (Nat.succ fuel') (stmt :: stmts) codeOverride state =
      .error err := by
  simp [EvmYul.Yul.execSeq, hHead]

/-- Current EVMYulLean sequence semantics: a normally returned `.Ok` head
    continues with the tail, while checkpoint/out-of-fuel states stop the
    open sequence immediately. -/
theorem execSeq_cons_ok_eq
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state next : EvmYul.Yul.State)
    (hHead : EvmYul.Yul.exec fuel' stmt codeOverride state = .ok next) :
    EvmYul.Yul.execSeq (Nat.succ fuel') (stmt :: stmts) codeOverride state =
      match next with
      | .Ok _ _ => EvmYul.Yul.execSeq fuel' stmts codeOverride next
      | .OutOfFuel => .ok next
      | .Checkpoint _ => .ok next := by
  cases next <;> simp [EvmYul.Yul.execSeq, hHead]

theorem execSeq_singleton_ok_of_exec_ok
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state next : EvmYul.Yul.State)
    (hHead : EvmYul.Yul.exec (Nat.succ fuel') stmt codeOverride state =
      .ok next) :
    EvmYul.Yul.execSeq (Nat.succ (Nat.succ fuel')) [stmt] codeOverride state =
      .ok next := by
  cases next <;> simp [EvmYul.Yul.execSeq, hHead]

/-- A closed block is an open sequence followed by EVMYulLean's block-scope
    varstore restriction. -/
theorem exec_block_of_execSeq_ok
    (fuel' : Nat)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state final : EvmYul.Yul.State)
    (hSeq : EvmYul.Yul.execSeq fuel' stmts codeOverride state = .ok final) :
    EvmYul.Yul.exec (Nat.succ fuel') (.Block stmts) codeOverride state =
      .ok (final.restrictStoreTo state.store) := by
  simp [EvmYul.Yul.exec, hSeq]

theorem exec_block_of_execSeq_error
    (fuel' : Nat)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hSeq : EvmYul.Yul.execSeq fuel' stmts codeOverride state = .error err) :
    EvmYul.Yul.exec (Nat.succ fuel') (.Block stmts) codeOverride state =
      .error err := by
  simp [EvmYul.Yul.exec, hSeq]

/-- A closed block at positive fuel is exactly the corresponding open sequence,
    with EVMYulLean's block scoping applied to successful results. -/
theorem exec_block_eq_match_execSeq
    (fuel' : Nat)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State) :
    EvmYul.Yul.exec (Nat.succ fuel') (.Block stmts) codeOverride state =
      match EvmYul.Yul.execSeq fuel' stmts codeOverride state with
      | .error e => .error e
      | .ok final => .ok (final.restrictStoreTo state.store) := by
  simp [EvmYul.Yul.exec]
  rfl

theorem execSeq_of_exec_block_error
    (fuel' : Nat)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hExec :
      EvmYul.Yul.exec (Nat.succ fuel') (.Block stmts) codeOverride state =
        .error err) :
    EvmYul.Yul.execSeq fuel' stmts codeOverride state = .error err := by
  rw [exec_block_eq_match_execSeq fuel' stmts codeOverride state] at hExec
  cases hSeq : EvmYul.Yul.execSeq fuel' stmts codeOverride state with
  | error err' =>
      simp [hSeq] at hExec
      simpa [hExec] using hSeq
  | ok final =>
      simp [hSeq] at hExec

/-- If the head statement of a native block finishes normally, current closed
    block execution continues according to `execSeq` and then restricts the
    resulting store to the block's entry scope. -/
theorem exec_block_cons_ok
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state next final : EvmYul.Yul.State)
    (hHead : EvmYul.Yul.exec fuel' stmt codeOverride state = .ok next)
    (hTail :
      (match next with
      | .Ok _ _ => EvmYul.Yul.execSeq fuel' stmts codeOverride next
      | .OutOfFuel => .ok next
      | .Checkpoint _ => .ok next) = .ok final) :
    EvmYul.Yul.exec (fuel' + 2) (.Block (stmt :: stmts)) codeOverride state =
      .ok (final.restrictStoreTo state.store) := by
  have hSeq :
      EvmYul.Yul.execSeq (Nat.succ fuel') (stmt :: stmts) codeOverride state =
        .ok final := by
    cases next <;> simpa [EvmYul.Yul.execSeq, hHead] using hTail
  have hFuel : fuel' + 2 = Nat.succ (Nat.succ fuel') := by omega
  rw [hFuel]
  exact exec_block_of_execSeq_ok (Nat.succ fuel') (stmt :: stmts)
    codeOverride state final hSeq

/-- Tail-generic peel of a native block whose head statement finishes
    normally, stated against current `execSeq`/scope semantics. -/
theorem exec_block_cons_ok_eq
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state next : EvmYul.Yul.State)
    (hHead : EvmYul.Yul.exec fuel' stmt codeOverride state = .ok next) :
    EvmYul.Yul.exec (fuel' + 2) (.Block (stmt :: stmts)) codeOverride state =
      match next with
      | .Ok _ _ =>
          match EvmYul.Yul.execSeq fuel' stmts codeOverride next with
          | .error e => .error e
          | .ok final => .ok (final.restrictStoreTo state.store)
      | .OutOfFuel => .ok (next.restrictStoreTo state.store)
      | .Checkpoint _ => .ok (next.restrictStoreTo state.store) := by
  have hFuel : fuel' + 2 = Nat.succ (Nat.succ fuel') := by omega
  rw [hFuel]
  cases next <;> simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq, hHead] <;> rfl

/-- If the head statement of a native block halts or errors, the whole block
    halts or errors immediately. -/
theorem exec_block_cons_error
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hHead : EvmYul.Yul.exec fuel' stmt codeOverride state = .error err) :
    EvmYul.Yul.exec (fuel' + 2) (.Block (stmt :: stmts)) codeOverride state =
      .error err := by
  have hSeq :
      EvmYul.Yul.execSeq (Nat.succ fuel') (stmt :: stmts) codeOverride state =
        .error err :=
    execSeq_cons_error fuel' stmt stmts codeOverride state err hHead
  have hFuel : fuel' + 2 = Nat.succ (Nat.succ fuel') := by omega
  rw [hFuel]
  exact exec_block_of_execSeq_error (Nat.succ fuel') (stmt :: stmts)
    codeOverride state err hSeq

/-- If the head statement of a native block finishes normally but the tail
    halts or errors, the whole block halts or errors after the head update. -/
theorem exec_block_cons_tail_error
    (fuel' : Nat)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (stmts : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state next : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hHead : EvmYul.Yul.exec fuel' stmt codeOverride state = .ok next)
    (hTail :
      (match next with
      | .Ok _ _ => EvmYul.Yul.execSeq fuel' stmts codeOverride next
      | .OutOfFuel => .ok next
      | .Checkpoint _ => .ok next) = .error err) :
    EvmYul.Yul.exec (fuel' + 2) (.Block (stmt :: stmts)) codeOverride state =
      .error err := by
  have hSeq :
      EvmYul.Yul.execSeq (Nat.succ fuel') (stmt :: stmts) codeOverride state =
        .error err := by
    cases next <;> simpa [EvmYul.Yul.execSeq, hHead] using hTail
  have hFuel : fuel' + 2 = Nat.succ (Nat.succ fuel') := by omega
  rw [hFuel]
  exact exec_block_of_execSeq_error (Nat.succ fuel') (stmt :: stmts)
    codeOverride state err hSeq

/-- Closed-block wrapper for an already-established open-sequence append
    success. The proof of open-sequence append is the semantic work; this
    wrapper only applies the closed block's final store restriction. -/
theorem exec_block_append_ok
    (seqFuel : Nat) (left right : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state final : EvmYul.Yul.State)
    (hSeq :
      EvmYul.Yul.execSeq seqFuel (left ++ right) codeOverride state =
        .ok final) :
    EvmYul.Yul.exec (Nat.succ seqFuel) (.Block (left ++ right))
      codeOverride state = .ok (final.restrictStoreTo state.store) :=
  exec_block_of_execSeq_ok seqFuel (left ++ right) codeOverride state final hSeq

/-- Closed-block wrapper for an already-established open-sequence append
    error. -/
theorem exec_block_append_error
    (seqFuel : Nat) (left right : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hSeq :
      EvmYul.Yul.execSeq seqFuel (left ++ right) codeOverride state =
        .error err) :
    EvmYul.Yul.exec (Nat.succ seqFuel) (.Block (left ++ right))
      codeOverride state = .error err := by
  exact exec_block_of_execSeq_error seqFuel (left ++ right) codeOverride
    state err hSeq

/-- If an appended block's left prefix halts or errors, the full appended block
    halts or errors before reaching the right suffix. -/
theorem exec_block_append_prefix_error
    (seqFuel : Nat) (left right : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hSeq :
      EvmYul.Yul.execSeq seqFuel (left ++ right) codeOverride state =
        .error err) :
    EvmYul.Yul.exec (Nat.succ seqFuel) (.Block (left ++ right))
      codeOverride state = .error err := by
  exact exec_block_of_execSeq_error seqFuel (left ++ right) codeOverride
    state err hSeq

theorem execSeq_append_ok_of_left
    (fuel : Nat)
    (left right : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state mid final : EvmYul.Yul.State)
    (hLeft :
      EvmYul.Yul.execSeq (fuel + left.length) left codeOverride state =
        .ok mid)
    (hRightDirect :
      EvmYul.Yul.execSeq fuel right codeOverride mid = .ok final)
    (hRightStop :
      (match mid with
      | .Ok _ _ => EvmYul.Yul.execSeq fuel right codeOverride mid
      | .OutOfFuel => .ok mid
      | .Checkpoint _ => .ok mid) = .ok final) :
    EvmYul.Yul.execSeq (fuel + left.length) (left ++ right) codeOverride state =
      .ok final := by
  induction left generalizing fuel state mid final with
  | nil =>
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.execSeq] at hLeft
      | succ fuel' =>
          simp [EvmYul.Yul.execSeq] at hLeft
          subst mid
          simpa [EvmYul.Yul.execSeq] using hRightDirect
  | cons stmt rest ih =>
      have hFuel :
          fuel + (stmt :: rest).length = Nat.succ (fuel + rest.length) := by
        simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      rw [hFuel] at hLeft ⊢
      cases hHead :
          EvmYul.Yul.exec (fuel + rest.length) stmt codeOverride state with
      | error err =>
          simp [EvmYul.Yul.execSeq, hHead] at hLeft
      | ok next =>
          cases next with
          | Ok shared store =>
              have hLeftRest :
                  EvmYul.Yul.execSeq (fuel + rest.length) rest codeOverride
                    (EvmYul.Yul.State.Ok shared store) = .ok mid := by
                simpa [EvmYul.Yul.execSeq, hHead] using hLeft
              simpa [EvmYul.Yul.execSeq, hHead] using
                ih fuel (EvmYul.Yul.State.Ok shared store) mid final
                  hLeftRest hRightDirect hRightStop
          | OutOfFuel =>
              have hMid : EvmYul.Yul.State.OutOfFuel = mid := by
                simpa [EvmYul.Yul.execSeq, hHead] using hLeft
              symm at hMid
              subst mid
              simpa [EvmYul.Yul.execSeq, hHead] using hRightStop
          | Checkpoint jump =>
              have hMid : EvmYul.Yul.State.Checkpoint jump = mid := by
                simpa [EvmYul.Yul.execSeq, hHead] using hLeft
              symm at hMid
              subst mid
              simpa [EvmYul.Yul.execSeq, hHead] using hRightStop

theorem execSeq_append_error_of_left
    (fuel : Nat)
    (left right : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hLeft :
      EvmYul.Yul.execSeq (fuel + left.length) left codeOverride state =
        .error err) :
    EvmYul.Yul.execSeq (fuel + left.length) (left ++ right) codeOverride state =
      .error err := by
  induction left generalizing fuel state with
  | nil =>
      cases fuel <;> simpa [EvmYul.Yul.execSeq] using hLeft
  | cons stmt rest ih =>
      have hFuel :
          fuel + (stmt :: rest).length = Nat.succ (fuel + rest.length) := by
        simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      rw [hFuel] at hLeft ⊢
      cases hHead :
          EvmYul.Yul.exec (fuel + rest.length) stmt codeOverride state with
      | error headErr =>
          simpa [EvmYul.Yul.execSeq, hHead] using hLeft
      | ok next =>
          cases next with
          | Ok shared store =>
              have hRest :
                  EvmYul.Yul.execSeq (fuel + rest.length) rest codeOverride
                    (EvmYul.Yul.State.Ok shared store) = .error err := by
                simpa [EvmYul.Yul.execSeq, hHead] using hLeft
              simpa [EvmYul.Yul.execSeq, hHead] using
                ih fuel (EvmYul.Yul.State.Ok shared store) hRest
          | OutOfFuel =>
              simp [EvmYul.Yul.execSeq, hHead] at hLeft
          | Checkpoint jump =>
              simp [EvmYul.Yul.execSeq, hHead] at hLeft

theorem execSeq_append_tail_error_of_left_ok
    (fuel : Nat)
    (left right : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state mid : EvmYul.Yul.State)
    (err : EvmYul.Yul.Exception)
    (hLeft :
      EvmYul.Yul.execSeq (fuel + left.length) left codeOverride state =
        .ok mid)
    (hMidOk : ∃ shared store, mid = EvmYul.Yul.State.Ok shared store)
    (hRight :
      EvmYul.Yul.execSeq fuel right codeOverride mid = .error err) :
    EvmYul.Yul.execSeq (fuel + left.length) (left ++ right) codeOverride state =
      .error err := by
  induction left generalizing fuel state mid with
  | nil =>
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.execSeq] at hLeft
      | succ fuel' =>
          simp [EvmYul.Yul.execSeq] at hLeft
          subst mid
          simpa [EvmYul.Yul.execSeq] using hRight
  | cons stmt rest ih =>
      have hFuel :
          fuel + (stmt :: rest).length = Nat.succ (fuel + rest.length) := by
        simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      rw [hFuel] at hLeft ⊢
      cases hHead :
          EvmYul.Yul.exec (fuel + rest.length) stmt codeOverride state with
      | error headErr =>
          simp [EvmYul.Yul.execSeq, hHead] at hLeft
      | ok next =>
          cases next with
          | Ok shared store =>
              have hLeftRest :
                  EvmYul.Yul.execSeq (fuel + rest.length) rest codeOverride
                    (EvmYul.Yul.State.Ok shared store) = .ok mid := by
                simpa [EvmYul.Yul.execSeq, hHead] using hLeft
              simpa [EvmYul.Yul.execSeq, hHead] using
                ih fuel (EvmYul.Yul.State.Ok shared store) mid hLeftRest
                  hMidOk hRight
          | OutOfFuel =>
              obtain ⟨shared, store, hMid⟩ := hMidOk
              subst mid
              simp [EvmYul.Yul.execSeq, hHead] at hLeft
          | Checkpoint jump =>
              obtain ⟨shared, store, hMid⟩ := hMidOk
              subst mid
              simp [EvmYul.Yul.execSeq, hHead] at hLeft

theorem exec_block_nil_ok
    (fuel' : Nat)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State) :
    EvmYul.Yul.exec (fuel' + 2) (.Block []) codeOverride state =
      .ok (state.restrictStoreTo state.store) := by
  have hFuel : fuel' + 2 = Nat.succ (Nat.succ fuel') := by omega
  rw [hFuel]
  simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq]

theorem exec_block_nil_ok_add_ten
