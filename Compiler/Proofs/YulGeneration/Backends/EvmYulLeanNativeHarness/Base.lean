/-- Peel the no-op native statement emitted for a source Yul comment.

Lowering `.comment` produces `.Block []`; this lemma removes that head block
from an enclosing native block while accounting for the two positive fuel
steps needed by the outer cons and the inner empty block. -/
theorem exec_block_noop_block_head_eq
    (fuel : Nat)
    (rest : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State) :
    EvmYul.Yul.exec (fuel + 4)
        (.Block (.Block [] :: rest)) codeOverride state =
      match state.restrictStoreTo state.store with
      | .Ok _ _ =>
          match EvmYul.Yul.execSeq (fuel + 2) rest codeOverride
              (state.restrictStoreTo state.store) with
          | .error e => .error e
          | .ok final => .ok (final.restrictStoreTo state.store)
      | .OutOfFuel =>
          .ok ((state.restrictStoreTo state.store).restrictStoreTo state.store)
      | .Checkpoint _ =>
          .ok ((state.restrictStoreTo state.store).restrictStoreTo state.store) := by
  have hFuel : fuel + 4 = Nat.succ (Nat.succ (fuel + 2)) := by omega
  rw [hFuel]
  cases state with
  | Ok shared store =>
      simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
        EvmYul.Yul.State.restrictStoreTo]
      rfl
  | OutOfFuel =>
      simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
        EvmYul.Yul.State.restrictStoreTo]
  | Checkpoint jump =>
      cases jump <;>
        simp [EvmYul.Yul.exec, EvmYul.Yul.execSeq,
          EvmYul.Yul.State.restrictStoreTo]

