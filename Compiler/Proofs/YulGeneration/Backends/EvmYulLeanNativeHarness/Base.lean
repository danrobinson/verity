theorem NativeBlockPreservesWord_revived_of_seq
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hSeq : NativeSeqPreservesWord_revived name value body codeOverride) :
    NativeBlockPreservesWord_revived name value body codeOverride := by
  intro fuel state final hScoped hLookup hExec
  cases fuel with
  | zero => simp [EvmYul.Yul.exec] at hExec
  | succ fuel' =>
      simp [EvmYul.Yul.exec] at hExec
      cases hSeqExec :
          EvmYul.Yul.execSeq fuel' body codeOverride state with
      | error err =>
          simp [hSeqExec] at hExec
      | ok seqFinal =>
          simp [hSeqExec] at hExec
          subst final
          have hSeqLookup : seqFinal.reviveJump[name]! = value :=
            hSeq fuel' state seqFinal hScoped hLookup hSeqExec
          have hEq :
              seqFinal.reviveJump[name]! = state.reviveJump[name]! :=
            hSeqLookup.trans hLookup.symm
          exact
            (state_reviveJump_getElem_restrictStoreTo_of_scoped_eq seqFinal
              state name hScoped hEq).trans hLookup

theorem NativeBlockPreservesLookup_revived_of_seq
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hSeq : NativeSeqPreservesLookup_revived name value body codeOverride) :
    NativeBlockPreservesLookup_revived name value body codeOverride := by
  intro fuel state final hScoped hLookup hExec
  cases fuel with
  | zero => simp [EvmYul.Yul.exec] at hExec
  | succ fuel' =>
      simp [EvmYul.Yul.exec] at hExec
      cases hSeqExec :
          EvmYul.Yul.execSeq fuel' body codeOverride state with
      | error err =>
          simp [hSeqExec] at hExec
      | ok seqFinal =>
          simp [hSeqExec] at hExec
          subst final
          have hSeqLookup :
              EvmYul.Yul.State.lookup? name seqFinal.reviveJump = some value :=
            hSeq fuel' state seqFinal hScoped hLookup hSeqExec
          have hStateLookup :
              EvmYul.Yul.State.lookup? name state = some value := by
            simpa [hScoped] using hLookup
          have hRestrict :
              EvmYul.Yul.State.lookup? name
                  (seqFinal.reviveJump.restrictStoreTo state.store) =
                some value :=
            state_lookup?_restrictStoreTo_of_lookup?_eq_of_scoped
              seqFinal.reviveJump state name hScoped hSeqLookup hStateLookup
          cases seqFinal with
          | Ok shared store =>
              simpa [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.restrictStoreTo] using hRestrict
          | OutOfFuel =>
              simpa [EvmYul.Yul.State.reviveJump,
                EvmYul.Yul.State.restrictStoreTo] using hRestrict
          | Checkpoint jump =>
              cases jump <;>
                simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
                  EvmYul.Yul.State.restrictStoreTo] using hRestrict

/-- Given a `_revived` head-stmt witness and a `_revived` rest-block witness,
build the cons block witness. Mirrors `NativeBlockPreservesWord_cons` for
the revived form. -/
theorem NativeBlockPreservesWord_revived_cons
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (rest : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hHead : NativeStmtPreservesWord_revived name value stmt codeOverride)
    (hRest : NativeSeqPreservesWord_revived name value rest codeOverride) :
    NativeBlockPreservesWord_revived name value (stmt :: rest) codeOverride :=
  NativeBlockPreservesWord_revived_of_seq name value (stmt :: rest) codeOverride
    (NativeSeqPreservesWord_revived_cons name value stmt rest codeOverride
      hHead hRest)

theorem NativeBlockPreservesWord_revived_singleton
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hStmt : NativeStmtPreservesWord_revived name value stmt codeOverride) :
    NativeBlockPreservesWord_revived name value [stmt] codeOverride :=
  NativeBlockPreservesWord_revived_cons name value stmt [] codeOverride hStmt
    (NativeSeqPreservesWord_revived_nil name value codeOverride)

/-- Generated-switch matched flag endpoint for Leave-aware bodies. The body
    preservation proof is stated through `reviveJump`; once the final checkpoint
    has been revived to an `Ok` state, checkpoint state projections make the raw
    final lookup agree with the revived lookup expected by the switch tail. -/
theorem nativeSwitchMatchedFlag_of_revived_body_final
    (switchId : Nat)
    (matchedName : EvmYul.Identifier)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (initial final : EvmYul.Yul.State)
    (fuel : Nat)
    (shared : EvmYul.SharedState EvmYul.OperationType.Yul)
    (store : EvmYul.Yul.VarStore)
    (_hMatchedName : matchedName = Backends.nativeSwitchMatchedTempName switchId)
    (hPreserves :
      NativeBlockPreservesWord_revived matchedName
        (EvmYul.UInt256.ofNat 1) body codeOverride)
    (hInitial :
      initial.reviveJump[matchedName]! =
        EvmYul.UInt256.ofNat 1)
    (hExec :
      EvmYul.Yul.exec fuel (.Block body) codeOverride initial = .ok final)
    (_hRevive : final.reviveJump = EvmYul.Yul.State.Ok shared store)
    (hInitialScoped : initial.reviveJump = initial) :
    final.reviveJump[matchedName]! = EvmYul.UInt256.ofNat 1 :=
  hPreserves fuel initial final hInitialScoped hInitial hExec

theorem nativeSwitchMatchedFlag_of_revived_seq_final
    (switchId : Nat)
    (matchedName : EvmYul.Identifier)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (initial final : EvmYul.Yul.State)
    (fuel : Nat)
    (shared : EvmYul.SharedState EvmYul.OperationType.Yul)
    (store : EvmYul.Yul.VarStore)
    (_hMatchedName : matchedName = Backends.nativeSwitchMatchedTempName switchId)
    (hPreserves :
      NativeSeqPreservesWord_revived matchedName
        (EvmYul.UInt256.ofNat 1) body codeOverride)
    (hInitial :
      initial.reviveJump[matchedName]! =
        EvmYul.UInt256.ofNat 1)
    (hExec :
      EvmYul.Yul.execSeq fuel body codeOverride initial = .ok final)
    (_hRevive : final.reviveJump = EvmYul.Yul.State.Ok shared store)
    (hInitialScoped : initial.reviveJump = initial) :
    final.reviveJump[matchedName]! = EvmYul.UInt256.ofNat 1 :=
  hPreserves fuel initial final hInitialScoped hInitial hExec

/-- `_revived` `.Block` constructor wrapper — mirrors the OLD-form
`NativeStmtPreservesWord_block`. `.Block body` exec and a list-body
preservation share the same definition shape, so the witness is the
hypothesis directly. -/
theorem NativeStmtPreservesWord_revived_block
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hBody : NativeBlockPreservesWord_revived name value body codeOverride) :
    NativeStmtPreservesWord_revived name value (.Block body) codeOverride :=
  hBody

theorem NativeStmtPreservesLookup_revived_block
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hBody : NativeBlockPreservesLookup_revived name value body codeOverride) :
    NativeStmtPreservesLookup_revived name value (.Block body) codeOverride :=
  hBody

theorem NativeSeqPreservesWord_of_forall_stmt
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hPreserves :
      ∀ stmt, stmt ∈ body →
        NativeStmtPreservesWord name value stmt codeOverride) :
    NativeSeqPreservesWord name value body codeOverride := by
  induction body with
  | nil =>
      exact NativeSeqPreservesWord_nil name value codeOverride
  | cons stmt rest ih =>
      refine NativeSeqPreservesWord_cons name value stmt rest codeOverride ?_ ?_
      · exact hPreserves stmt (by simp)
      · exact ih (by
          intro stmt' hmem
          exact hPreserves stmt' (by simp [hmem]))

theorem NativeBlockPreservesWord_of_forall_stmt
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hPreserves :
      ∀ stmt, stmt ∈ body →
        NativeStmtPreservesWord name value stmt codeOverride) :
    NativeBlockPreservesWord name value body codeOverride :=
  NativeBlockPreservesWord_of_seq name value body codeOverride
    (NativeSeqPreservesWord_of_forall_stmt name value body codeOverride
      hPreserves)

theorem NativeBlockPreservesWord_of_forall_stmt_write_not_mem
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hFresh :
      ∀ stmt, stmt ∈ body → name ∉ Backends.nativeStmtWriteNames stmt)
    (hPreserves :
      ∀ stmt, stmt ∈ body →
        name ∉ Backends.nativeStmtWriteNames stmt →
          NativeStmtPreservesWord name value stmt codeOverride) :
    NativeBlockPreservesWord name value body codeOverride :=
  NativeBlockPreservesWord_of_forall_stmt name value body codeOverride
    (by
      intro stmt hmem
      exact hPreserves stmt hmem (hFresh stmt hmem))

