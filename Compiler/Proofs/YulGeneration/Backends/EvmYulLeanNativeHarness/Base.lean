    (hFinalMatched :
      EvmYul.Yul.State.lookup? (Backends.nativeSwitchMatchedTempName switchId)
        (final.restrictStoreTo
          (nativeSwitchStorePrefixStateForId contract tx storage observableSlots
            switchId nativeSwitchHasSelectorStore).store) =
