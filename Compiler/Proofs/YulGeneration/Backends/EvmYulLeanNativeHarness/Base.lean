        (final.restrictStoreTo
          (nativeSwitchStorePrefixStateForId contract tx storage
            observableSlots switchId nativeSwitchHasSelectorStore).store)
        (nativeSwitchStoreInitialState contract tx storage observableSlots
          nativeSwitchHasSelectorStore).store
  simpa [nativeSwitchHasSelectorInitialState, lowerFinal, hScoped] using
    exec_block_cons_ok (fuel + cases.length + 13) _ [] _ _ lowerFinal lowerFinal
