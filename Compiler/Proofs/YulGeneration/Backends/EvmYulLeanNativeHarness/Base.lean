          ∀ tag' body', (tag', body') ∈ rest →
            EvmYul.UInt256.ofNat tag ≠ EvmYul.UInt256.ofNat tag' := by
        intro tag' body' hmem
        exact hMissPrefix tag' body' (by simp [hmem])
