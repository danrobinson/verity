      some (EvmYul.UInt256.ofNat 1)) :
    EvmYul.Yul.exec
      (fuel + (nativeSwitchDefaultIf matchedName defaultBody).length + 8)
      (.Block (nativeSwitchDefaultIf matchedName defaultBody))
      codeOverride state = .ok state := by
