private theorem state_reviveJump_getElem_restrictStoreTo_of_scoped_eq
    (state scope : EvmYul.Yul.State)
    (name : EvmYul.Identifier)
    (hScoped : scope.reviveJump = scope)
    (hEq : state.reviveJump[name]! = scope.reviveJump[name]!) :
    (state.restrictStoreTo scope.store).reviveJump[name]! =
      scope.reviveJump[name]! := by
  cases scope with
  | Ok scopeShared scopeStore =>
      cases state with
      | Ok shared store =>
          simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.restrictStoreTo,
            EvmYul.Yul.State.store] using
            state_getElem_restrictStoreTo_of_getElem_eq
              (EvmYul.Yul.State.Ok shared store)
              (EvmYul.Yul.State.Ok scopeShared scopeStore) name hEq
      | OutOfFuel =>
          simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.restrictStoreTo,
            EvmYul.Yul.State.store] using hEq
      | Checkpoint jump =>
          cases jump with
          | Continue shared store =>
              simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
                EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store] using
                state_getElem_restrictStoreTo_of_getElem_eq
                  (EvmYul.Yul.State.Ok shared store)
                  (EvmYul.Yul.State.Ok scopeShared scopeStore) name hEq
          | Break shared store =>
              simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
                EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store] using
                state_getElem_restrictStoreTo_of_getElem_eq
                  (EvmYul.Yul.State.Ok shared store)
                  (EvmYul.Yul.State.Ok scopeShared scopeStore) name hEq
          | Leave shared store =>
              simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive,
                EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store] using
                state_getElem_restrictStoreTo_of_getElem_eq
                  (EvmYul.Yul.State.Ok shared store)
                  (EvmYul.Yul.State.Ok scopeShared scopeStore) name hEq
  | OutOfFuel =>
      simpa [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.store,
        literal_outOfBounds_eq_default] using
        state_reviveJump_getElem_restrictStoreTo_default state name
  | Checkpoint jump =>
      cases jump <;> cases hScoped

theorem NativePrimCallPreservesWord_calldatasize
    (name : EvmYul.Identifier)
    (expected : EvmYul.Literal) :
    ∀ fuel state final rets,
      state[name]! = expected →
        EvmYul.Yul.primCall fuel state EvmYul.Operation.CALLDATASIZE [] =
          .ok (final, rets) →
        final[name]! = expected := by
  intro fuel state final rets hLookup hExec
  cases fuel with
  | zero =>
