      EvmYul.Yul.State.lookup? discrName
        (final.restrictStoreTo state.store) =
          some finalDiscrValue) :
    EvmYul.Yul.execSeq
      (fuel + (pre ++ (tag, body) :: suffix).length + 9)
      (nativeSwitchCaseIfs discrName matchedName
        (pre ++ (tag, body) :: suffix))
      codeOverride state = .ok (final.restrictStoreTo state.store) := by
  induction pre generalizing fuel with
  | nil =>
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        (execSeq_nativeSwitchCaseIfs_head_hit_fuel fuel suffix tag body
          codeOverride state final discrName matchedName finalDiscrValue
          hMatched hDiscr hBody hFinalMatched hFinalDiscr)
  | cons entry rest ih =>
