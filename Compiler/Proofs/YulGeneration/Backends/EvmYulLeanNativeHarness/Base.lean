private theorem varStore_eraseAllEntries_toFinmap_empty
    (alist : AList (fun _ : EvmYul.Identifier => EvmYul.Literal)) :
    List.foldl
      (fun (store : EvmYul.Yul.VarStore)
          (entry : Sigma (fun _ : EvmYul.Identifier => EvmYul.Literal)) =>
        Finmap.erase entry.1 store)
      (AList.toFinmap alist) alist.entries =
      (∅ : EvmYul.Yul.VarStore) := by
  cases alist with
  | mk entries nodup =>
      induction entries with
      | nil =>
          rfl
      | cons head rest ih =>
          cases head with
          | mk key value =>
              have hRestNodup : rest.NodupKeys :=
                List.nodupKeys_of_nodupKeys_cons nodup
              have ihRest := ih hRestNodup
              simp only [List.foldl_cons]
              have hErase :
                  Finmap.erase key
                      (AList.toFinmap
                        ⟨Sigma.mk key value :: rest, nodup⟩) =
                    AList.toFinmap ⟨rest, hRestNodup⟩ := by
                apply Finmap.ext_lookup
                intro lookupKey
                by_cases hEq : lookupKey = key
                · subst lookupKey
                  rw [Finmap.lookup_erase]
                  symm
                  have hNotMem : key ∉ rest.keys :=
                    List.notMem_keys_of_nodupKeys_cons nodup
                  rw [Finmap.lookup_toFinmap]
                  rw [AList.lookup_eq_none]
                  simpa [AList.mem_keys] using hNotMem
                · rw [Finmap.lookup_erase_ne]
                  · simp [AList.lookup, List.dlookup_cons_ne, hEq]
                  · exact hEq
              rw [hErase]
              exact ihRest

private theorem varStore_sdiff_self_empty
    (store : EvmYul.Yul.VarStore) :
    store.sdiff store = (∅ : EvmYul.Yul.VarStore) := by
  induction store using Finmap.induction_on with
  | H alist =>
      simpa [Finmap.sdiff, Finmap.foldl] using
        varStore_eraseAllEntries_toFinmap_empty alist

private theorem varStore_sdiff_empty_right
    (store : EvmYul.Yul.VarStore) :
    store.sdiff (∅ : EvmYul.Yul.VarStore) = store := by
  rw [Finmap.sdiff]
  rfl

private theorem varStore_not_mem_default
    (name : EvmYul.Identifier) :
    name ∉ (Inhabited.default : EvmYul.Yul.VarStore) := by
  change name ∉ (∅ : EvmYul.Yul.VarStore)
  exact Finmap.notMem_empty

private theorem literal_outOfBounds_eq_default :
    (outOfBounds : EvmYul.Literal) =
      (Inhabited.default : EvmYul.Literal) := rfl

private theorem varStore_lookup_sdiff_of_not_mem_right
    (name : EvmYul.Identifier)
    (store erased : EvmYul.Yul.VarStore)
    (hNotMem : name ∉ erased) :
    Finmap.lookup name (store.sdiff erased) = Finmap.lookup name store := by
  rw [Finmap.sdiff, Finmap.foldl]
  let eraseEntry :
      EvmYul.Yul.VarStore →
        (Sigma fun _ : EvmYul.Identifier => EvmYul.Literal) →
          EvmYul.Yul.VarStore :=
    fun acc entry => Finmap.erase entry.1 acc
  letI : RightCommutative eraseEntry :=
    ⟨by intro acc a b; exact Finmap.erase_erase⟩
  change Finmap.lookup name
      (Multiset.foldl eraseEntry store erased.entries) =
    Finmap.lookup name store
  refine Multiset.foldl_induction'
    (f := eraseEntry)
    (x := store)
    (q := fun entry => entry.1 ≠ name)
    (p := fun acc => Finmap.lookup name acc = Finmap.lookup name store)
    erased.entries ?step rfl ?all
  · intro entry acc hKey hAcc
    rw [show eraseEntry acc entry = Finmap.erase entry.1 acc from rfl]
    rw [Finmap.lookup_erase_ne]
    · exact hAcc
    · exact Ne.symm hKey
  · intro entry hEntry hEq
    apply (by simpa [Finmap.mem_def] using hNotMem)
    rw [← hEq]
    exact Multiset.mem_map_of_mem Sigma.fst hEntry

private theorem varStore_lookup_erase_multiset_none
    (name : EvmYul.Identifier)
    (entries : Multiset (Sigma fun _ : EvmYul.Identifier => EvmYul.Literal))
    (store : EvmYul.Yul.VarStore)
    (hNone : Finmap.lookup name store = none) :
    (let eraseEntry :
        EvmYul.Yul.VarStore →
          (Sigma fun _ : EvmYul.Identifier => EvmYul.Literal) →
            EvmYul.Yul.VarStore :=
      fun acc entry => Finmap.erase entry.1 acc
     letI : RightCommutative eraseEntry :=
      ⟨by intro acc a b; exact Finmap.erase_erase⟩
     Finmap.lookup name (Multiset.foldl eraseEntry store entries)) = none := by
  dsimp only
  let eraseEntry :
      EvmYul.Yul.VarStore →
        (Sigma fun _ : EvmYul.Identifier => EvmYul.Literal) →
          EvmYul.Yul.VarStore :=
    fun acc entry => Finmap.erase entry.1 acc
  letI : RightCommutative eraseEntry :=
    ⟨by intro acc a b; exact Finmap.erase_erase⟩
  refine Multiset.foldl_induction'
    (f := eraseEntry)
    (x := store)
    (q := fun _ => True)
    (p := fun acc => Finmap.lookup name acc = none)
    entries ?step hNone ?all
  · intro entry acc _ hAcc
    rw [show eraseEntry acc entry = Finmap.erase entry.1 acc from rfl]
    by_cases hEq : name = entry.1
    · subst hEq
      exact Finmap.lookup_erase entry.1 acc
    · rw [Finmap.lookup_erase_ne hEq]
      exact hAcc
  · simp

private theorem varStore_lookup_sdiff_of_mem_right
    (name : EvmYul.Identifier)
    (store erased : EvmYul.Yul.VarStore)
    (hMem : name ∈ erased) :
    Finmap.lookup name (store.sdiff erased) = none := by
  obtain ⟨value, hLookupErased⟩ := Finmap.mem_iff.mp hMem
  have hEntry : Sigma.mk name value ∈ erased.entries :=
    Finmap.lookup_eq_some_iff.mp hLookupErased
  obtain ⟨rest, hEntries⟩ := Multiset.exists_cons_of_mem hEntry
  rw [Finmap.sdiff, Finmap.foldl, hEntries]
  let eraseEntry :
      EvmYul.Yul.VarStore →
        (Sigma fun _ : EvmYul.Identifier => EvmYul.Literal) →
          EvmYul.Yul.VarStore :=
    fun acc entry => Finmap.erase entry.1 acc
  letI : RightCommutative eraseEntry :=
    ⟨by intro acc a b; exact Finmap.erase_erase⟩
  change Finmap.lookup name
      (Multiset.foldl eraseEntry store (Sigma.mk name value ::ₘ rest)) =
    none
  rw [Multiset.foldl_cons]
  exact varStore_lookup_erase_multiset_none name rest (Finmap.erase name store)
    (Finmap.lookup_erase name store)

private theorem restrictVarStore_lookup_of_mem_scope
    (name : EvmYul.Identifier)
    (store scope : EvmYul.Yul.VarStore)
    (hScope : name ∈ scope) :
    Finmap.lookup name
        (EvmYul.Yul.State.restrictVarStore store scope) =
      Finmap.lookup name store := by
  have hNotErased : name ∉ store.sdiff scope := by
    exact Finmap.lookup_eq_none.mp
      (varStore_lookup_sdiff_of_mem_right name store scope hScope)
  rw [EvmYul.Yul.State.restrictVarStore]
  exact varStore_lookup_sdiff_of_not_mem_right name store (store.sdiff scope)
    hNotErased

private theorem restrictVarStore_lookup_of_not_mem_scope
    (name : EvmYul.Identifier)
    (store scope : EvmYul.Yul.VarStore)
    (hScope : name ∉ scope) :
    Finmap.lookup name
        (EvmYul.Yul.State.restrictVarStore store scope) =
      none := by
  rw [EvmYul.Yul.State.restrictVarStore]
  by_cases hStore : name ∈ store
  · obtain ⟨value, hLookup⟩ := Finmap.mem_iff.mp hStore
    have hErased : name ∈ store.sdiff scope :=
      Finmap.mem_of_lookup_eq_some
        (by
          rw [varStore_lookup_sdiff_of_not_mem_right name store scope hScope]
          exact hLookup)
    exact varStore_lookup_sdiff_of_mem_right name store (store.sdiff scope)
      hErased
  · have hNotErased : name ∉ store.sdiff scope := by
      apply Finmap.lookup_eq_none.mp
      rw [varStore_lookup_sdiff_of_not_mem_right name store scope hScope]
      exact Finmap.lookup_eq_none.mpr hStore
    rw [varStore_lookup_sdiff_of_not_mem_right name store (store.sdiff scope)
      hNotErased]
    exact Finmap.lookup_eq_none.mpr hStore

private theorem restrictVarStore_self
    (store : EvmYul.Yul.VarStore) :
    EvmYul.Yul.State.restrictVarStore store store = store := by
  rw [EvmYul.Yul.State.restrictVarStore, varStore_sdiff_self_empty,
    varStore_sdiff_empty_right]

private theorem restrictVarStore_idempotent_scope
    (store scope : EvmYul.Yul.VarStore) :
    EvmYul.Yul.State.restrictVarStore
        (EvmYul.Yul.State.restrictVarStore store scope) scope =
      EvmYul.Yul.State.restrictVarStore store scope := by
  apply Finmap.ext_lookup
  intro name
  by_cases hScope : name ∈ scope
  · rw [restrictVarStore_lookup_of_mem_scope name
      (EvmYul.Yul.State.restrictVarStore store scope) scope hScope]
  · rw [restrictVarStore_lookup_of_not_mem_scope name
      (EvmYul.Yul.State.restrictVarStore store scope) scope hScope]
    rw [restrictVarStore_lookup_of_not_mem_scope name store scope hScope]

theorem state_getElem_restrictStoreTo_self
    (state : EvmYul.Yul.State)
    (name : EvmYul.Identifier) :
    (state.restrictStoreTo state.store)[name]! = state[name]! := by
  cases state with
  | Ok shared store =>
      simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
        EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
        GetElem?.getElem!, decidableGetElem?, GetElem.getElem,
        restrictVarStore_self]
  | OutOfFuel =>
      simp [EvmYul.Yul.State.restrictStoreTo]
  | Checkpoint jump =>
      cases jump with
      | Continue shared store =>
          simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
            GetElem?.getElem!, decidableGetElem?, GetElem.getElem]
          by_cases hmem : name ∈ (Inhabited.default : EvmYul.Yul.VarStore)
          · exfalso
            change name ∈ (∅ : EvmYul.Yul.VarStore) at hmem
            exact Finmap.notMem_empty hmem
          · simp [hmem]
      | Break shared store =>
          simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
            GetElem?.getElem!, decidableGetElem?, GetElem.getElem]
          by_cases hmem : name ∈ (Inhabited.default : EvmYul.Yul.VarStore)
          · exfalso
            change name ∈ (∅ : EvmYul.Yul.VarStore) at hmem
            exact Finmap.notMem_empty hmem
          · simp [hmem]
      | Leave shared store =>
          simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
            GetElem?.getElem!, decidableGetElem?, GetElem.getElem]
          by_cases hmem : name ∈ (Inhabited.default : EvmYul.Yul.VarStore)
          · exfalso
            change name ∈ (∅ : EvmYul.Yul.VarStore) at hmem
            exact Finmap.notMem_empty hmem
          · simp [hmem]

private theorem state_restrictStoreTo_self_of_reviveJump_eq
    (state : EvmYul.Yul.State)
    (hScoped : state.reviveJump = state) :
    state.restrictStoreTo state.store = state := by
  cases state with
  | Ok shared store =>
      simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store,
        restrictVarStore_self]
  | OutOfFuel =>
      simp [EvmYul.Yul.State.restrictStoreTo]
  | Checkpoint jump =>
      cases jump <;>
        simp [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive] at hScoped

theorem ok_restrictStoreTo_self
    (shared : EvmYul.SharedState EvmYul.OperationType.Yul)
    (store : EvmYul.Yul.VarStore) :
    (EvmYul.Yul.State.Ok shared store).restrictStoreTo store =
      EvmYul.Yul.State.Ok shared store := by
  simp [EvmYul.Yul.State.restrictStoreTo, restrictVarStore_self]

theorem leave_restrictStoreTo_self
    (shared : EvmYul.SharedState EvmYul.OperationType.Yul)
    (store : EvmYul.Yul.VarStore) :
    (EvmYul.Yul.State.Checkpoint
      (EvmYul.Yul.Jump.Leave shared store)).restrictStoreTo store =
      EvmYul.Yul.State.Checkpoint
        (EvmYul.Yul.Jump.Leave shared store) := by
  simp [EvmYul.Yul.State.restrictStoreTo, restrictVarStore_self]

private theorem state_restrictStoreTo_idempotent_scope
    (state : EvmYul.Yul.State)
    (scope : EvmYul.Yul.VarStore) :
    (state.restrictStoreTo scope).restrictStoreTo scope =
      state.restrictStoreTo scope := by
  cases state with
  | Ok shared store =>
      simp [EvmYul.Yul.State.restrictStoreTo,
        restrictVarStore_idempotent_scope]
  | OutOfFuel =>
      simp [EvmYul.Yul.State.restrictStoreTo]
  | Checkpoint jump =>
      cases jump <;>
        simp [EvmYul.Yul.State.restrictStoreTo,
          restrictVarStore_idempotent_scope]

private theorem state_getElem_restrictStoreTo_default
    (state : EvmYul.Yul.State)
    (name : EvmYul.Identifier) :
    (state.restrictStoreTo
      (Inhabited.default : EvmYul.Yul.VarStore))[name]! =
      (Inhabited.default : EvmYul.Literal) := by
  cases state with
  | Ok shared store =>
      have hScope : name ∉ (Inhabited.default : EvmYul.Yul.VarStore) :=
        varStore_not_mem_default name
      have hLookup :=
        restrictVarStore_lookup_of_not_mem_scope name store
