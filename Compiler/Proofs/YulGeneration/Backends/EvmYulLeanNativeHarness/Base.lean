    body codeOverride state (state.insert matchedName (EvmYul.UInt256.ofNat 1))
    final (by simpa using
      (exec_lowerAssignNative_lit_ok 4 matchedName 1 codeOverride state
        (EvmYul.UInt256.ofNat 0) hMatched)) hBody

