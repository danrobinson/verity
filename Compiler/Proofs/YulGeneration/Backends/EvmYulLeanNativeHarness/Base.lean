            simp [EvmYul.Yul.State.lookup?] at hMatched
        | Checkpoint jump =>
            cases jump <;>
              simp [EvmYul.Yul.State.reviveJump, EvmYul.Yul.State.revive]
                at hScoped
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        (execSeq_nativeSwitchCaseIfs_cons_miss_fuel fuel
          (rest ++ (tag, body) :: suffix) missTag missBody codeOverride state
          (final.restrictStoreTo state.store) discrName matchedName
          (EvmYul.UInt256.ofNat tag) hMatched hDiscr hHeadMiss hTail)

