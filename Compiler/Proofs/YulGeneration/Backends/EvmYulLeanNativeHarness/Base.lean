theorem execSeq_nativeSwitchPrefix_selector_initialState_ok_fuel
    (fuel : Nat) (contract : EvmYul.Yul.Ast.YulContract) (tx : YulTransaction)
    (storage : IRStorageSlot → IRStorageWord) (observableSlots : List Nat)
    (discrName matchedName : EvmYul.Identifier)
    (hNamesNe : discrName ≠ matchedName) :
    EvmYul.Yul.execSeq (fuel + 12)
      (nativeSwitchPrefixStmts discrName matchedName)
      (some contract) (nativeSwitchInitialOkState contract tx storage observableSlots) =
    .ok (nativeSwitchPrefixFinalState contract tx storage observableSlots
      discrName matchedName) := by
  let initState : EvmYul.Yul.State :=
    nativeSwitchInitialOkState contract tx storage observableSlots
  let discrState : EvmYul.Yul.State :=
    initState.insert discrName
      (EvmYul.UInt256.ofNat
        (tx.functionSelector % Compiler.Constants.selectorModulus))
  let matchedState : EvmYul.Yul.State :=
    discrState.insert matchedName (EvmYul.UInt256.ofNat 0)
  change EvmYul.Yul.execSeq (fuel + 12)
      (nativeSwitchPrefixStmts discrName matchedName)
      (some contract) initState = .ok matchedState
  rw [nativeSwitchPrefixStmts]
  have hHead :
      EvmYul.Yul.exec (fuel + 11)
        (.Let [discrName]
          (some (Backends.lowerExprNative
            Compiler.Proofs.YulGeneration.selectorExpr)))
        (some contract) initState = .ok discrState := by
    simpa [initState, discrState, nativeSwitchInitialOkState] using
      (exec_let_lowerExprNative_selectorExpr_initialState_ok_fuel
        fuel contract tx storage observableSlots discrName)
  have hFreshMatched :
      EvmYul.Yul.State.lookup? matchedName discrState = none := by
    have hNe' : matchedName ≠ discrName := by
      intro h; exact hNamesNe h.symm
    simp [discrState, initState, nativeSwitchInitialOkState,
      EvmYul.Yul.State.insert, EvmYul.Yul.State.lookup?,
      Finmap.lookup_insert_of_ne _ hNe']
  have hTail :
      EvmYul.Yul.exec (fuel + 10)
        (.Let [matchedName] (some (.Lit (EvmYul.UInt256.ofNat 0))))
        (some contract) discrState = .ok matchedState := by
    simpa [matchedState, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      (exec_let_lit_ok (fuel + 8) matchedName (EvmYul.UInt256.ofNat 0)
        (some contract) discrState hFreshMatched)
  have hFuelSeq : fuel + 12 = Nat.succ (fuel + 11) := by omega
  have hFuelTail : fuel + 11 = Nat.succ (fuel + 10) := by omega
  rw [hFuelSeq]
  rw [execSeq_cons_ok_eq _ _ _ _ _ _ hHead]
  change EvmYul.Yul.execSeq (fuel + 11)
      [EvmYul.Yul.Ast.Stmt.Let [matchedName]
        (some (.Lit (EvmYul.UInt256.ofNat 0)))]
      (some contract) discrState = .ok matchedState
  rw [hFuelTail]
  rw [execSeq_cons_ok_eq _ _ _ _ _ _ hTail]
  change EvmYul.Yul.execSeq (fuel + 10) [] (some contract) matchedState =
    .ok matchedState
  have hFuelDone : fuel + 10 = Nat.succ (fuel + 9) := by omega
  rw [hFuelDone]
  simp [EvmYul.Yul.execSeq]

