  have hPrefix :
      EvmYul.Yul.execSeq (fuel + 12)
        (nativeSwitchPrefixStmts discrName matchedName)
        (some contract) initState = .ok prefixState := by
    simpa [prefixState, initState, discrName, matchedName, Nat.add_assoc,
      Nat.add_comm, Nat.add_left_comm] using
      exec_nativeSwitchPrefix_selector_initialState_store_ok_fuel
        fuel contract tx storage observableSlots store discrName matchedName
        hDiscrFresh hMatchedFresh hne
  have hTailStop :
      (match prefixState with
      | .Ok _ _ =>
          EvmYul.Yul.execSeq (fuel + 10)
            (nativeSwitchTailStmts switchId cases defaultBody)
            (some contract) prefixState
      | .OutOfFuel => .ok prefixState
      | .Checkpoint _ => .ok prefixState) = .ok final := by
    simpa [prefixState, initState, nativeSwitchStorePrefixStateForId,
      nativeSwitchStoreInitialState, EvmYul.Yul.State.insert, discrName,
      matchedName] using hTail
  have hSeq :
      EvmYul.Yul.execSeq (fuel + 10 +
          (nativeSwitchPrefixStmts discrName matchedName).length)
        (nativeSwitchPrefixStmts discrName matchedName ++
          nativeSwitchTailStmts switchId cases defaultBody)
        (some contract) initState = .ok final :=
    execSeq_append_ok_of_left (fuel + 10)
      (nativeSwitchPrefixStmts discrName matchedName)
      (nativeSwitchTailStmts switchId cases defaultBody)
      (some contract) initState prefixState final
      (by simpa [nativeSwitchPrefixStmts, Nat.add_assoc, Nat.add_comm,
        Nat.add_left_comm] using hPrefix)
      (by simpa [prefixState, initState, discrName, matchedName] using hTail)
      hTailStop
  rw [lowerNativeSwitchBlock_selectorExpr_eq_nativeSwitchParts]
  simpa [nativeSwitchPrefixStmts, discrName, matchedName, initState,
    Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
    (exec_block_append_ok (fuel + 12)
      (nativeSwitchPrefixStmts discrName matchedName)
      (nativeSwitchTailStmts switchId cases defaultBody)
      (some contract) initState final
      (by simpa [nativeSwitchPrefixStmts, Nat.add_assoc, Nat.add_comm,
        Nat.add_left_comm] using hSeq))

