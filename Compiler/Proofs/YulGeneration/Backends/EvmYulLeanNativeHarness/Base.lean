      (by simpa [prefixState, scopedFinal, matchedName] using hFinalMatched)
      (by simpa [prefixState, scopedFinal, discrName] using hFinalDiscr)
  have hDefaultDirect :
      EvmYul.Yul.execSeq (fuel + 10)
