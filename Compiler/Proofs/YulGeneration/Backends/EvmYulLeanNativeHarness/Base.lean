        sloadFuel mstoreFuel returnFuel contract tx storage observableSlots
        store =
        .error (EvmYul.Yul.Exception.YulHalt haltState haltValue) ∧
      projectResult tx storage initialEvents
          (.error (EvmYul.Yul.Exception.YulHalt haltState haltValue)) =
        { success := true
