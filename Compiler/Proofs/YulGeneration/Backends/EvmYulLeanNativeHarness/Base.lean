/-- Compose a generated case chain with its optional default when the case chain
    has already set and preserved the matched flag. -/
theorem exec_nativeSwitchCaseIfs_with_default_matched_fuel
    (fuel : Nat)
    (cases : List (Nat × List EvmYul.Yul.Ast.Stmt))
    (defaultBody : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state final : EvmYul.Yul.State)
    (discrName matchedName : EvmYul.Identifier)
    (hCases :
      EvmYul.Yul.execSeq (fuel + cases.length + 9)
        (nativeSwitchCaseIfs discrName matchedName cases)
        codeOverride state = .ok final)
    (hFinalMatched : EvmYul.Yul.State.lookup? matchedName final =
      some (EvmYul.UInt256.ofNat 1)) :
    EvmYul.Yul.exec (fuel + cases.length + 10)
      (.Block
        (nativeSwitchCaseIfs discrName matchedName cases ++
          nativeSwitchDefaultIf matchedName defaultBody))
      codeOverride state = .ok (final.restrictStoreTo state.store) := by
  have hDefaultDirect :
      EvmYul.Yul.execSeq (fuel + 9)
        (nativeSwitchDefaultIf matchedName defaultBody) codeOverride final =
        .ok final :=
    execSeq_nativeSwitchDefaultIf_matched_caseTail_fuel fuel defaultBody
      codeOverride final matchedName hFinalMatched
  have hDefaultStop :
      (match final with
      | .Ok _ _ =>
          EvmYul.Yul.execSeq (fuel + 9)
            (nativeSwitchDefaultIf matchedName defaultBody) codeOverride final
      | .OutOfFuel => .ok final
      | .Checkpoint _ => .ok final) = .ok final := by
    cases final with
    | Ok shared store =>
        simpa using hDefaultDirect
    | OutOfFuel =>
        rfl
    | Checkpoint jump =>
        rfl
  have hSeq :
      EvmYul.Yul.execSeq (fuel + 9 +
          (nativeSwitchCaseIfs discrName matchedName cases).length)
        (nativeSwitchCaseIfs discrName matchedName cases ++
          nativeSwitchDefaultIf matchedName defaultBody)
        codeOverride state = .ok final := by
    exact execSeq_append_ok_of_left (fuel + 9)
      (nativeSwitchCaseIfs discrName matchedName cases)
      (nativeSwitchDefaultIf matchedName defaultBody)
      codeOverride state final final
      (by simpa [nativeSwitchCaseIfs, Nat.add_assoc, Nat.add_comm,
        Nat.add_left_comm] using hCases)
      hDefaultDirect
      hDefaultStop
  have hClosed :=
    exec_block_append_ok
      (fuel + cases.length + 9)
      (nativeSwitchCaseIfs discrName matchedName cases)
      (nativeSwitchDefaultIf matchedName defaultBody)
      codeOverride state final
