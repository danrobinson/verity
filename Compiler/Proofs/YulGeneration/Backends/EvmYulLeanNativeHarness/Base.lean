              GetElem.getElem, varStore_not_mem_default name] using hLookup
          have hNe :
              (outOfBounds : EvmYul.Literal) ≠
                EvmYul.UInt256.ofNat 1 := by
            decide
          exact False.elim (hNe hContra)
      | Break shared store =>
          have hContra :
              (outOfBounds : EvmYul.Literal) =
                EvmYul.UInt256.ofNat 1 := by
            simpa [EvmYul.Yul.State.lookup!, EvmYul.Yul.State.lookup?,
