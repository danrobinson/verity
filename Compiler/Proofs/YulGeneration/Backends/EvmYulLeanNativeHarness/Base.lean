  cases defaultBody with
  | nil =>
      have hSeq :
          EvmYul.Yul.execSeq (fuel + 7) [] codeOverride state = .ok state := by
        simp [EvmYul.Yul.execSeq]
      have hClosed :=
        exec_block_of_execSeq_ok (fuel + 7) [] codeOverride state state hSeq
      simpa [nativeSwitchDefaultIf, Nat.add_assoc, Nat.add_comm,
        Nat.add_left_comm, hSelf] using hClosed
