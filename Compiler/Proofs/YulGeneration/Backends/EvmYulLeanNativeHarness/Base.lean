            next[name]! = value)
    (hRest : NativeSeqPreservesWord name value rest codeOverride) :
    NativeBlockPreservesWord name value (stmt :: rest) codeOverride :=
  NativeBlockPreservesWord_of_seq name value (stmt :: rest) codeOverride
