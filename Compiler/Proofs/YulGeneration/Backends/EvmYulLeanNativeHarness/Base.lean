          (match state with
          | .Ok _ _ => EvmYul.Yul.execSeq (fuel + 7) [] codeOverride state
          | .OutOfFuel => .ok state
          | .Checkpoint _ => .ok state) = .ok state := by
        cases state <;> simp [EvmYul.Yul.execSeq]
      simpa [nativeSwitchDefaultIf, hSelf] using
        (exec_block_cons_ok (fuel + 7)
          (.If (nativeSwitchDefaultGuardExpr matchedName) (stmt :: rest))
          [] codeOverride state state state hHead hTail)

