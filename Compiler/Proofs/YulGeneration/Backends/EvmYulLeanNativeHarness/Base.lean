          contract tx storage observableSlots switchId store) = .ok final)
    (hFinalMatched :
      EvmYul.Yul.State.lookup? (Backends.nativeSwitchMatchedTempName switchId)
        (final.restrictStoreTo
          (nativeSwitchPostInitFreeMemoryStorePrefixStateForId contract tx
            storage observableSlots switchId store).store) =
          some (EvmYul.UInt256.ofNat 1))
    (hFinalDiscr :
      EvmYul.Yul.State.lookup? (Backends.nativeSwitchDiscrTempName switchId)
        (final.restrictStoreTo
          (nativeSwitchPostInitFreeMemoryStorePrefixStateForId contract tx
            storage observableSlots switchId store).store) =
          some (EvmYul.UInt256.ofNat selector)) :
    EvmYul.Yul.exec (fuel + cases.length + 13)
      (Backends.lowerNativeSwitchBlock
        Compiler.Proofs.YulGeneration.selectorExpr switchId cases defaultBody)
      (some contract)
      (nativeSwitchPostInitFreeMemoryState contract tx storage observableSlots
        store) =
    .ok ((final.restrictStoreTo
      (nativeSwitchPostInitFreeMemoryStorePrefixStateForId contract tx storage
        observableSlots switchId store).store).restrictStoreTo
          (nativeSwitchPostInitFreeMemoryState contract tx storage
            observableSlots store).store) := by
  let discrName := Backends.nativeSwitchDiscrTempName switchId
  let matchedName := Backends.nativeSwitchMatchedTempName switchId
  let prefixState :=
    nativeSwitchPostInitFreeMemoryStorePrefixStateForId contract tx storage
      observableSlots switchId store
  let scopedFinal := final.restrictStoreTo prefixState.store
  have hne := nativeSwitchDiscrTempName_ne_matchedTempName switchId
  have hCasesOnly :
      EvmYul.Yul.execSeq (fuel + 1 + cases.length + 9)
        (nativeSwitchCaseIfs discrName matchedName cases)
        (some contract)
        prefixState = .ok scopedFinal := by
    exact execSeq_nativeSwitchCaseIfs_find_hit_fuel
      (fuel + 1) selector cases tag body (some contract)
      prefixState final discrName matchedName (EvmYul.UInt256.ofNat selector)
      hFind
      (by
        simp [prefixState, nativeSwitchPostInitFreeMemoryStorePrefixStateForId,
          nativeSwitchPostInitFreeMemoryState, EvmYul.Yul.State.insert,
          EvmYul.Yul.State.reviveJump])
      (by
        simpa [prefixState, nativeSwitchPostInitFreeMemoryStorePrefixStateForId,
          discrName, matchedName] using
          nativeSwitchPostInitFreeMemoryPrefixStoreState_matched_lookup?
            contract tx storage observableSlots store discrName matchedName
            (EvmYul.UInt256.ofNat
              (tx.functionSelector % Compiler.Constants.selectorModulus)))
      (by
        simpa [prefixState, nativeSwitchPostInitFreeMemoryStorePrefixStateForId,
          discrName, matchedName] using
          nativeSwitchPostInitFreeMemoryPrefixStoreState_discr_lookup?
            contract tx storage observableSlots store discrName matchedName
