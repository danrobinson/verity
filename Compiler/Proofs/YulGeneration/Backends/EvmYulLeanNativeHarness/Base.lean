    (cases : List (Nat × List EvmYul.Yul.Ast.Stmt))
    (defaultBody body : List EvmYul.Yul.Ast.Stmt)
    (contract : EvmYul.Yul.Ast.YulContract)
    (tx : YulTransaction)
