  | MissingContract s => rfl
  | MissingContractFunction s => rfl
  | InvalidExpression => rfl
  | UnknownIdentifier s => rfl
  | DuplicateDeclaration s => rfl
  | YulEXTCODESIZENotImplemented => rfl
  | Revert state => rfl

