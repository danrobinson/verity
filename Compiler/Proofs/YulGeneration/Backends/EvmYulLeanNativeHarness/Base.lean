/-- If no case tag matches and the matched flag is still clear, the generated
    native switch case chain skips every case body and leaves the state
    unchanged. -/
theorem exec_nativeSwitchCaseIfs_all_miss_fuel
    (fuel : Nat)
    (cases : List (Nat × List EvmYul.Yul.Ast.Stmt))
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (state : EvmYul.Yul.State)
    (discrName matchedName : EvmYul.Identifier)
    (hScoped : state.reviveJump = state)
    (discrValue : EvmYul.UInt256)
    (hMatched : EvmYul.Yul.State.lookup? matchedName state =
      some (EvmYul.UInt256.ofNat 0))
    (hDiscrLookup : EvmYul.Yul.State.lookup? discrName state =
      some discrValue)
    (hMiss :
      ∀ tag body, (tag, body) ∈ cases →
        discrValue ≠ EvmYul.UInt256.ofNat tag) :
    EvmYul.Yul.exec (fuel + cases.length + 10)
      (.Block (nativeSwitchCaseIfs discrName matchedName cases))
      codeOverride state = .ok state := by
  have hSeq :
      EvmYul.Yul.execSeq (fuel + cases.length + 9)
        (nativeSwitchCaseIfs discrName matchedName cases) codeOverride state =
        .ok state := by
    induction cases generalizing fuel with
    | nil =>
        simp [nativeSwitchCaseIfs, EvmYul.Yul.execSeq]
    | cons entry rest ih =>
        rcases entry with ⟨tag, body⟩
        have hHeadMiss : discrValue ≠ EvmYul.UInt256.ofNat tag := by
          exact hMiss tag body (by simp)
        have hRestMiss :
            ∀ tag' body', (tag', body') ∈ rest →
              discrValue ≠ EvmYul.UInt256.ofNat tag' := by
          intro tag' body' hmem
          exact hMiss tag' body' (by simp [hmem])
        have hHead :
            EvmYul.Yul.exec (fuel + rest.length + 9)
              (nativeSwitchCaseIf discrName matchedName (tag, body))
              codeOverride state = .ok state := by
          simpa [nativeSwitchCaseIf, nativeSwitchGuardedMatchExpr] using
            (exec_if_nativeSwitchGuardedMatch_miss_fuel
              (fuel + rest.length)
              (Backends.lowerAssignNative matchedName (.lit 1) :: body)
              codeOverride state discrName matchedName tag discrValue hMatched
              hDiscrLookup hHeadMiss)
        have hTail :
            EvmYul.Yul.execSeq (fuel + rest.length + 9)
              (nativeSwitchCaseIfs discrName matchedName rest)
              codeOverride state = .ok state :=
          ih fuel hRestMiss
        have hFuel :
            fuel + ((tag, body) :: rest).length + 9 =
              Nat.succ (fuel + rest.length + 9) := by
          simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
        rw [nativeSwitchCaseIfs_cons, hFuel,
          execSeq_cons_ok_eq _ _ _ _ _ _ hHead]
        cases state <;> simpa [nativeSwitchCaseIfs] using hTail
  have hClosed :=
    exec_block_of_execSeq_ok (fuel + cases.length + 9)
      (nativeSwitchCaseIfs discrName matchedName cases) codeOverride state state
      hSeq
  have hSelf := state_restrictStoreTo_self_of_reviveJump_eq state hScoped
  simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm, hSelf] using hClosed

