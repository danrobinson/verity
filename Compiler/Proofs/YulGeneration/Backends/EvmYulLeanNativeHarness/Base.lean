theorem NativeBlockPreservesWord_nil
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract) :
    NativeBlockPreservesWord name value [] codeOverride := by
  intro fuel state final hLookup hExec
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.exec] at hExec
  | succ fuel' =>
      simp [EvmYul.Yul.exec] at hExec
      cases fuel' with
      | zero =>
          simp [EvmYul.Yul.execSeq] at hExec
      | succ fuel'' =>
          simp [EvmYul.Yul.execSeq] at hExec
          cases hExec
          rw [state_getElem_restrictStoreTo_self]
          exact hLookup

theorem NativeSeqPreservesWord_nil
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract) :
    NativeSeqPreservesWord name value [] codeOverride := by
  intro fuel state final hLookup hExec
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.execSeq] at hExec
  | succ fuel' =>
      simp [EvmYul.Yul.execSeq] at hExec
      cases hExec
      exact hLookup

theorem NativeSeqPreservesWord_cons
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (stmt : EvmYul.Yul.Ast.Stmt)
    (rest : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hHead :
      ∀ fuel state next,
        state[name]! = value →
          EvmYul.Yul.exec fuel stmt codeOverride state = .ok next →
            next[name]! = value)
    (hRest : NativeSeqPreservesWord name value rest codeOverride) :
    NativeSeqPreservesWord name value (stmt :: rest) codeOverride := by
  intro fuel state final hLookup hExec
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.execSeq] at hExec
  | succ fuel' =>
      cases hStmt : EvmYul.Yul.exec fuel' stmt codeOverride state with
      | error err =>
          simp [EvmYul.Yul.execSeq, hStmt] at hExec
      | ok next =>
          have hNext : next[name]! = value :=
            hHead fuel' state next hLookup hStmt
          cases next with
          | Ok shared store =>
              simp [EvmYul.Yul.execSeq, hStmt] at hExec
              exact hRest fuel' (EvmYul.Yul.State.Ok shared store) final
                hNext hExec
          | OutOfFuel =>
              simp [EvmYul.Yul.execSeq, hStmt] at hExec
              cases hExec
              exact hNext
          | Checkpoint jump =>
              simp [EvmYul.Yul.execSeq, hStmt] at hExec
              cases hExec
              exact hNext

theorem NativeBlockPreservesWord_of_seq
    (name : EvmYul.Identifier)
    (value : EvmYul.Literal)
    (body : List EvmYul.Yul.Ast.Stmt)
    (codeOverride : Option EvmYul.Yul.Ast.YulContract)
    (hSeq : NativeSeqPreservesWord name value body codeOverride) :
    NativeBlockPreservesWord name value body codeOverride := by
  intro fuel state final hLookup hExec
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.exec] at hExec
  | succ fuel' =>
      simp [EvmYul.Yul.exec] at hExec
      cases hSeqExec :
          EvmYul.Yul.execSeq fuel' body codeOverride state with
      | error err =>
          simp [hSeqExec] at hExec
      | ok seqFinal =>
          simp [hSeqExec] at hExec
          subst final
          have hSeqLookup : seqFinal[name]! = value :=
            hSeq fuel' state seqFinal hLookup hSeqExec
          have hEq : seqFinal[name]! = state[name]! :=
            hSeqLookup.trans hLookup.symm
          exact
            (state_getElem_restrictStoreTo_of_getElem_eq seqFinal state name hEq).trans
              hLookup

theorem NativeBlockPreservesWord_cons
